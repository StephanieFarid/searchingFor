<%= form_with(model: item, class: "bg-white rounded-lg border border-gray-200 p-6") do |form| %>
  <% if item.errors.any? %>
    <div class="bg-red-50 text-red-700 px-3 py-2 rounded-md mb-4">
      <ul class="list-disc ml-6">
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-5">
    <%= form.label :title, "What are you looking for?", class: "font-medium" %>
    <%= form.text_field :title, required: true, maxlength: 150, placeholder: "e.g. A vintage Polaroid SX-70", class: "block w-full mt-2 rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div class="mb-5">
    <%= form.label :description, "Details (optional)", class: "font-medium" %>
    <%= form.textarea :description, rows: 5, placeholder: "Condition, budget, location, anything that helps…", class: "block w-full mt-2 rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <%= form.submit item.new_record? ? "Post" : "Save changes", class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<% end %>
