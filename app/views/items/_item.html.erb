<% highlight = local_assigns.fetch(:highlights, {})[item.id] %>
<%= link_to item, id: dom_id(item), class: "block bg-white rounded-lg border border-line p-5 hover:border-primary hover:shadow-sm transition" do %>
  <h2 class="font-semibold text-lg"><span class="text-primary">Searching for</span> <%= highlight ? ItemSearch.highlight_html(highlight) : item.title %></h2>
  <% if item.description.present? %>
    <p class="text-muted mt-1 line-clamp-2"><%= item.description %></p>
  <% end %>
  <p class="text-xs text-muted mt-3">
    <%= time_ago_in_words(item.created_at) %> ago · <%= pluralize(item.comments_count, "comment") %>
  </p>
<% end %>
