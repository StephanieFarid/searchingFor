<dialog data-modal-target="dialog" data-action="click->modal#backdropClose"
        aria-labelledby="new-post-heading"
        class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-xl bg-white p-0 shadow-2xl backdrop:bg-primary-dark/60 backdrop:backdrop-blur-sm">
  <%= form_with model: Item.new, class: "p-6" do |f| %>
    <div class="flex items-start justify-between mb-5">
      <h2 id="new-post-heading" class="font-bold text-2xl">Create a post</h2>
      <button type="button" data-action="modal#close" aria-label="Close" class="text-muted hover:text-ink text-2xl leading-none cursor-pointer">&times;</button>
    </div>

    <label class="flex items-center rounded-md border border-line focus-within:outline-2 focus-within:outline-primary bg-white">
      <span class="pl-3 pr-1 py-3 font-semibold text-primary whitespace-nowrap select-none">I'm searching for</span>
      <%= f.text_field :title, required: true, maxlength: 150, autocomplete: "off",
            placeholder: "a vintage Polaroid SX-70",
            data: { modal_target: "focus" },
            aria: { label: "I'm searching for" },
            class: "flex-1 min-w-0 py-3 pr-3 bg-transparent outline-none" %>
    </label>

    <%= f.label :description, "Details (optional)", class: "block font-medium mt-5" %>
    <%= f.textarea :description, rows: 4, maxlength: 5000,
          placeholder: "Condition, budget, location, anything that helps…",
          class: "block w-full mt-2 rounded-md border border-line px-3 py-2 focus:outline-primary" %>

    <div class="flex flex-wrap items-center justify-between gap-3 mt-6">
      <p class="text-sm text-muted">Posts are fully anonymous.</p>
      <div class="flex gap-2">
        <button type="button" data-action="modal#close" class="rounded-md px-4 py-2 bg-subtle hover:bg-line font-medium cursor-pointer">Cancel</button>
        <%= f.submit "Post", class: "rounded-md px-5 py-2 bg-accent hover:bg-accent-soft text-accent-ink font-semibold cursor-pointer" %>
      </div>
    </div>
  <% end %>
</dialog>
