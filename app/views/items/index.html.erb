<% content_for :title, @query.present? ? "Search: #{@query}" : "Searching For" %>

<div class="flex items-baseline justify-between mb-6">
  <h1 class="font-bold text-3xl">
    <% if @query.present? %>
      Results for “<%= @query %>”
    <% else %>
      What people are searching for
    <% end %>
  </h1>
  <% if @query.present? %>
    <%= link_to "Clear search", items_path, class: "text-sm text-muted underline" %>
  <% end %>
</div>

<% if @query.present? %>
  <p class="text-sm text-muted -mt-4 mb-4"><%= pluralize(@items.size, "result") %></p>
<% end %>

<div id="items" class="space-y-4">
  <% if @items.any? %>
    <%= render partial: "items/item", collection: @items, locals: { highlights: @highlights } %>
  <% else %>
    <p class="text-center text-muted my-16">
      <%= @query.present? ? "Nothing matches that search." : "No one has posted yet. Hit “Create a post” to be the first!" %>
    </p>
  <% end %>
</div>
