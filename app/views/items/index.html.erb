<% content_for :title, @query.present? ? "Search: #{@query}" : "Looking For" %>

<div class="flex items-baseline justify-between mb-6">
  <h1 class="font-bold text-3xl">
    <% if @query.present? %>
      Results for “<%= @query %>”
    <% else %>
      What people are looking for
    <% end %>
  </h1>
  <% if @query.present? %>
    <%= link_to "Clear search", items_path, class: "text-sm text-gray-600 underline" %>
  <% end %>
</div>

<div id="items" class="space-y-4">
  <% if @items.any? %>
    <%= render @items %>
  <% else %>
    <p class="text-center text-gray-500 my-16">
      <%= @query.present? ? "Nothing matches that search." : "No one has posted yet — be the first!" %>
    </p>
  <% end %>
</div>
