<% content_for :title, "Searching for #{@item.title}" %>

<article class="bg-white rounded-lg border border-line p-6">
  <h1 class="font-bold text-3xl"><span class="text-primary">Searching for</span> <%= @item.title %></h1>
  <% if @item.description.present? %>
    <div class="mt-4 text-ink"><%= simple_format @item.description %></div>
  <% end %>
  <p class="text-xs text-muted mt-4">Posted <%= time_ago_in_words(@item.created_at) %> ago</p>
</article>

<section class="mt-8">
  <h2 class="font-semibold text-xl mb-4"><%= pluralize(@item.comments.size, "comment") %></h2>

  <div class="space-y-3">
    <% @item.comments.each do |comment| %>
      <div id="<%= dom_id comment %>" class="bg-white rounded-lg border border-line p-4">
        <p class="text-xs text-muted">Anonymous · <%= time_ago_in_words(comment.created_at) %> ago</p>
        <div class="mt-2 text-ink"><%= simple_format comment.body %></div>
      </div>
    <% end %>
  </div>

  <%= form_with model: [ @item, @comment ], class: "mt-6" do |f| %>
    <%= f.label :body, "Know where to find it? Leave an anonymous comment", class: "font-medium" %>
    <%= f.textarea :body, rows: 3, required: true, maxlength: 2000, class: "block w-full mt-2 rounded-md border border-line px-3 py-2 focus:outline-primary" %>
    <%= f.submit "Comment", class: "mt-2 rounded-md px-4 py-2 bg-primary hover:bg-primary-dark text-white font-medium cursor-pointer" %>
  <% end %>
</section>
