<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Searching For" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Searching For">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="modal" class="bg-surface text-ink font-sans antialiased min-h-screen">
    <header class="bg-white border-b border-line sticky top-0 z-10">
      <div class="h-1 bg-gradient-to-r from-primary via-primary to-accent"></div>
      <div class="max-w-4xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3">
        <%= link_to "Searching For", root_path, class: "font-bold text-xl text-primary shrink-0" %>

        <%= form_with url: items_path, method: :get, class: "flex-1 min-w-[12rem] flex", role: "search" do |f| %>
          <%= f.search_field :q, value: params[:q], placeholder: "Search posts…",
                aria: { label: "Search items" },
                class: "w-full rounded-l-md border border-line px-3 py-2 focus:outline-primary" %>
          <%= f.submit "Search", name: nil, class: "rounded-r-md bg-primary hover:bg-primary-dark text-white px-4 font-medium cursor-pointer" %>
        <% end %>

        <button type="button" data-action="modal#open"
                class="shrink-0 rounded-md px-4 py-2 bg-accent text-accent-ink font-semibold hover:bg-accent-soft cursor-pointer">
          Create a post
        </button>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <% if notice.present? %>
        <p class="py-2 px-3 bg-accent-soft mb-5 text-accent-ink font-medium rounded-md" id="notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-700 font-medium rounded-md" id="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>

    <%= render "items/new_post_dialog" %>
  </body>
</html>
