<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Looking For" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Looking For">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3">
        <%= link_to "Looking For", root_path, class: "font-bold text-xl text-blue-600 shrink-0" %>

        <%= form_with url: items_path, method: :get, class: "flex-1 min-w-[12rem] flex", role: "search" do |f| %>
          <%= f.search_field :q, value: params[:q], placeholder: "Search what people are looking for…",
                aria: { label: "Search items" },
                class: "w-full rounded-l-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
          <%= f.submit "Search", name: nil, class: "rounded-r-md bg-blue-600 hover:bg-blue-500 text-white px-4 font-medium cursor-pointer" %>
        <% end %>

        <nav class="flex items-center gap-3 text-sm shrink-0">
          <% if Current.user %>
            <%= link_to "+ Post", new_item_path, class: "rounded-md px-3 py-2 bg-gray-900 text-white font-medium hover:bg-gray-700" %>
            <span class="text-gray-500"><%= Current.user.name %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-gray-600 underline hover:no-underline cursor-pointer" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
            <%= link_to "Sign up", new_registration_path, class: "rounded-md px-3 py-2 bg-gray-900 text-white font-medium hover:bg-gray-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-md" id="notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-700 font-medium rounded-md" id="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
